# Runtime environment: development, test, or production.
APP_ENV=development
# Public semantic version returned by GET /version.
APP_VERSION=1.0.0
# PostgreSQL connection used by the API, worker, and Alembic.
DATABASE_URL=postgresql+psycopg://ai_ranking:ai_ranking@postgres:5432/ai_ranking
# Redis connection used by background workers.
REDIS_URL=redis://redis:6379/0
# Logging verbosity.
LOG_LEVEL=INFO
# Initial retry delay in seconds; retries use base * 2^(attempt-1).
EXECUTION_RETRY_BASE_SECONDS=0.1
# Set false to execute real provider HTTP requests.
PROVIDER_MOCK_MODE=true
# Provider credentials can also be mounted in /run/secrets or the Kubernetes secret path.
OPENAI_API_KEY=mock-openai-key
ANTHROPIC_API_KEY=mock-anthropic-key
GEMINI_API_KEY=mock-gemini-key
DEEPSEEK_API_KEY=mock-deepseek-key
PERPLEXITY_API_KEY=mock-perplexity-key
MISTRAL_API_KEY=mock-mistral-key
GROK_API_KEY=mock-grok-key
YANDEX_API_KEY=mock-yandex-key
YANDEX_FOLDER_ID=mock-folder-id
GIGACHAT_ACCESS_TOKEN=mock-gigachat-token
# Release/build metadata exposed by system monitoring.
BUILD_SHA=development
RELEASE_CHANNEL=rc2.1
# Required in production; use at least 32 random bytes.
AUTH_JWT_SECRET=development-only-change-me
# API process topology and graceful shutdown.
WEB_CONCURRENCY=2
GRACEFUL_SHUTDOWN_SECONDS=30
RUN_MIGRATIONS=false
# Must be true in production; health, metrics, docs, login and refresh remain public.
SECURITY_ENFORCE_AUTH=false
# SQLAlchemy QueuePool recovery and capacity controls.
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
