{
  "tables": {
    "graph_snapshots": {
      "columns": {
        "id": {"type": "INTEGER", "nullable": false}
      },
      "primary_key": ["id"]
    },
    "influence_snapshots": {
      "columns": {
        "id": {"type": "INTEGER", "nullable": false},
        "graph_snapshot_id": {"type": "INTEGER", "nullable": false},
        "algorithm_version": {"type": "VARCHAR(50)", "nullable": false},
        "node_count": {"type": "INTEGER", "nullable": false},
        "edge_count": {"type": "INTEGER", "nullable": false}
      },
      "primary_key": ["id"],
      "unique_constraints": [["graph_snapshot_id", "algorithm_version"]]
    },
    "entity_influence": {
      "columns": {
        "id": {"type": "INTEGER", "nullable": false},
        "snapshot_id": {
          "type": "INTEGER",
          "nullable": false,
          "foreign_key": "influence_snapshots.id"
        },
        "entity_id": {"type": "VARCHAR(300)", "nullable": false},
        "rank": {"type": "INTEGER", "nullable": false},
        "influence_score": {"type": "FLOAT", "nullable": false}
      },
      "primary_key": ["id"],
      "unique_constraints": [["snapshot_id", "entity_id"]]
    }
  }
}
